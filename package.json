{
  "name": "shanisarf",
  "version": "0.0.0",
  "description": "Arabic morphological analyzer for JavaScript: a TypeScript port of the analysis core of CAMeL Tools over the Camel Morph MSA database.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shani-go/shanisarf.git"
  },
  "homepage": "https://github.com/shani-go/shanisarf#readme",
  "bugs": {
    "url": "https://github.com/shani-go/shanisarf/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": {
        "import": "./dist/esm/index-node.js",
        "require": "./dist/cjs/index-node.js"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./compile": {
      "types": "./dist/compile/index.d.ts",
      "node": {
        "import": "./dist/esm/compile/index.js",
        "require": "./dist/cjs/compile/index.js"
      }
    },
    "./worker": {
      "types": "./dist/worker/client.d.ts",
      "node": {
        "import": "./dist/esm/worker/node-import.js",
        "require": "./dist/cjs/worker/node-require.js"
      },
      "default": "./dist/esm/worker/web.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE",
    "licenses",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run build:esm && npm run build:cjs && npm run build:types && node scripts/write-cjs-package.mjs && node scripts/check-build.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity:setup": "node scripts/parity.mjs setup",
    "parity:generate": "node scripts/parity.mjs generate",
    "parity:asset": "node scripts/parity-asset.mjs",
    "measure:db": "node --expose-gc scripts/measure-db.mjs",
    "compile:db": "node scripts/compile-db.mjs",
    "gen:features": "node scripts/gen-msa-features.mjs",
    "demo": "node scripts/demo-server.mjs",
    "bench": "node --expose-gc scripts/bench.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:consumer": "node scripts/check-consumer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.22.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
